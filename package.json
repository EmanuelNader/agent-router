{
  "name": "agent-router",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Portable coding-agent workspaces with allowance-aware cloud provisioning and recovery.",
  "bin": {
    "agent-router": "./bin/agent-router.mjs"
  },
  "packageManager": "pnpm@11.28.13",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "benchmark": "tsx scripts/benchmark.ts",
    "fixture:create": "node scripts/create-fixture.mjs",
    "fixture:hash": "tsx scripts/hash-fixture.ts",
    "readiness": "tsx scripts/readiness.ts",
    "agent:probe": "tsx scripts/probe-agent.ts",
    "agent:roundtrip": "tsx scripts/agent-roundtrip.ts",
    "agent:acp-roundtrip": "tsx scripts/acp-roundtrip.ts",
    "checkpoint:roundtrip": "tsx scripts/checkpoint-roundtrip.ts",
    "checkpoint:linux-roundtrip": "tsx scripts/linux-checkpoint-roundtrip.ts",
    "handoff:roundtrip": "tsx scripts/ssh-handoff-roundtrip.ts",
    "inspect:aws": "tsx scripts/inspect-aws.ts",
    "connect:oci": "tsx scripts/connect-oci.ts",
    "inspect:oci": "tsx scripts/inspect-oci.ts",
    "plan:oci": "tsx scripts/plan-oci.ts",
    "guard:oci": "tsx scripts/guard-oci.ts",
    "router": "tsx scripts/router.ts",
    "e2e": "tsx scripts/e2e.ts"
  },
  "devDependencies": {
    "@opencode/cli": "2.3.2",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@aws-sdk/client-freetier": "3.1167.0",
    "@aws-sdk/client-sts": "3.1167.0",
    "jsonc-parser": "3.3.1",
    "oci-sdk": "2.146.0",
    "smol-toml": "1.9.1",
    "zod": "4.6.7"
  }
}
