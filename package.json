{
  "name": "agent-router",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Portable coding-agent workspaces with allowance-aware cloud provisioning and recovery.",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "fixture:create": "node scripts/create-fixture.mjs",
    "fixture:hash": "tsx scripts/hash-fixture.ts",
    "readiness": "tsx scripts/readiness.ts",
    "agent:probe": "tsx scripts/probe-agent.ts",
    "agent:roundtrip": "tsx scripts/agent-roundtrip.ts",
    "inspect:aws": "tsx scripts/inspect-aws.ts",
    "connect:oci": "tsx scripts/connect-oci.ts",
    "inspect:oci": "tsx scripts/inspect-oci.ts",
    "plan:oci": "tsx scripts/plan-oci.ts",
    "deploy:oci": "tsx scripts/deploy-oci.ts",
    "destroy:oci": "tsx scripts/destroy-oci.ts"
  },
  "devDependencies": {
    "@opencode/cli": "2.2.7",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@aws-sdk/client-freetier": "3.1167.0",
    "@aws-sdk/client-sts": "3.1167.0",
    "oci-sdk": "2.146.0",
    "zod": "4.6.7"
  }
}
